{
  "manifest_version": 3,
  "name": "GoogleRefreshed",
  "version": "1.3.0",
  "description": "A considered Google homepage. Your search, shortcuts, colors, and a little space to focus.",
  "permissions": [
    "storage",
    "system.cpu",
    "system.memory"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://news.google.com/*",
    "https://ipwho.is/*",
    "https://suggestqueries.google.com/*",
    "https://feeds.bbci.co.uk/*",
    "https://www.theguardian.com/*",
    "https://www.google.com/*",
    "https://www.google.co.il/*",
    "https://www.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "GoogleRefreshed",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/services/*.png",
        "icons/services/*.svg",
        "refresh.css",
        "fonts/*.woff2",
        "hardware.html"
      ],
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.co.il/*",
        "https://google.co.il/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.co.il/*",
        "https://google.co.il/*"
      ],
      "exclude_matches": [
        "https://*/sorry/*"
      ],
      "js": [
        "shared.js",
        "boot.js",
        "results.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*",
        "https://www.google.co.il/*",
        "https://google.co.il/*"
      ],
      "exclude_matches": [
        "https://*/sorry/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
